{
  "name": "radio-study-desktop",
  "version": "1.3.2",
  "description": "Offline amateur radio grade 1 and grade 3 practice, grading and local records",
  "author": "Radio Study",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "kr.radio.study.desktop",
    "productName": "RadioStudy",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "RadioStudy-${version}-Windows-${arch}.${ext}",
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "compression": "store"
  }
}
